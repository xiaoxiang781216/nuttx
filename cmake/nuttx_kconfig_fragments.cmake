#
# Kconfig value fragments: overlay a handful of CONFIG_ assignments onto a board
# defconfig from the command line, so that a board's variants (toolchain, debug,
# test) do not each need their own physical defconfig.
#
# $ frag clang                 # build repo, sets VELA_KCONFIG_FRAGMENTS $ lunch
# mps3-an547:nsh $ m
#
# The fragments are appended to a copy of the (already #include-expanded) board
# defconfig at the end of the defconfig preprocess step, which is exactly the
# merge the preprocess step performs anyway -- later assignments win. The only
# difference to an #include is that the list comes from the command line.
#
# A fragment is referred to in exactly one of two ways, and nothing else:
#
# clang            a bare name, taken from the directory holding the board
# defconfig -- i.e. <board>/configs/<config>/clang.config /abs/path.config an
# explicit absolute path, for a fragment shared between boards or generated by
# CI. 'frag' makes the path absolute, because a relative one means the caller's
# directory and CMake runs with its own.
#
# Deliberately no search across several directories: a bare name resolves in one
# place only, so what 'frag clang' will pick up is answerable by looking at the
# board's config directory, without knowing a precedence order.
#
# ~~~
#   available()  the fragments next to the defconfig, for resolve()'s error
#   resolve()    token list  -> ordered absolute paths (+ human readable error)
#   validate()   reject '#include' and non-ASCII inside a fragment
#   signature()  ordered paths + contents -> short digest
#   assemble()   base defconfig + fragments -> .defconfig.assembled.<digest>
#   verify()     every value the fragments asked for took effect in .config
# ~~~
#
# None of them reads a global variable: everything comes in as an argument, so
# they can be driven from a plain `cmake -P` script without a board, a build
# directory or a toolchain.
#
# Three things are worth knowing before writing a fragment, because Kconfig
# drops an assignment that cannot be honoured *silently* -- the build still
# succeeds, with a configuration that is not the one the fragment asked for.
# verify() exists precisely because of this.
#
# 1. A choice member can only be switched, never unset. Writing '# CONFIG_MEMBER
#   is not set' sets that symbol's user value to n, but the choice keeps its
#   selection, and a member's value is derived from the selection -- so it reads
#   back as y. Select the sibling you want instead.
#
# 1. Only one member of a choice may be assigned. Assigning two silently keeps
#   the last one, and kconfiglib does not even warn (they are two different
#   symbols, so its assigned-twice check does not fire).
#
# 1. '#include' inside a fragment is silently swallowed: fragments are read by
#   kconfiglib's .config loader, which treats any unrecognised line starting
#   with '#' as a comment. validate() rejects it rather than let it look like it
#   worked. Fragments are flat; compose them on the command line.
#
# Malformed lines need no handling here: kconfiglib warns about those on its own
# ("ignoring malformed line"), and nuttx_olddefconfig() already surfaces its
# stderr as a CMake warning.
#
# Implementation note: this file never puts file *content* into a CMake list,
# and never relies on if(TRUE). Config values legitimately contain ';' (e.g.
# CONFIG_DRIVERS_VIRTIO_SERIAL_NAME="ttyV0;ttyHCI0") and '[' ']', which
# file(STRINGS) and list() would mangle, and list()/if() behaviour depends on
# CMP0007/CMP0012. Lines are scanned by hand with string(FIND)/string(SUBSTRING)
# so that the result is independent of both.
#
# ##############################################################################

# nuttx_kconfig_fragments_available(<out-var> DIR <dir>)
#
# Return the bare names of the fragments in <dir>, to make the "fragment not
# found" message actionable.

function(nuttx_kconfig_fragments_available outvar)
  cmake_parse_arguments(ARG "" "DIR" "" ${ARGN})

  set(RESULT)
  if(IS_DIRECTORY "${ARG_DIR}")
    file(GLOB FOUND "${ARG_DIR}/*.config")
    foreach(ENTRY ${FOUND})
      if(IS_DIRECTORY "${ENTRY}")
        continue()
      endif()
      get_filename_component(NAME "${ENTRY}" NAME_WE)
      list(APPEND RESULT "${NAME}")
    endforeach()
  endif()

  set(${outvar}
      "${RESULT}"
      PARENT_SCOPE)
endfunction()

# nuttx_kconfig_fragments_validate(<path> <out-err-var>)
#
# Set <out-err-var> to a human readable message when <path> cannot be used as a
# fragment, to the empty string otherwise. Only '#include' is rejected: see the
# header for why that one needs an explicit check and why malformed lines do
# not.

function(nuttx_kconfig_fragments_validate path outerr)
  set(ERR "")

  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    set(ERR "  not a readable file: ${path}\n")
  else()
    file(READ "${path}" CONTENT)

    string(REGEX MATCH "(^|\n)[ \t]*#include" HIT "${CONTENT}")
    if(NOT HIT STREQUAL "")
      set(ERR "  ${path}\n")
      string(APPEND ERR "    '#include' is not allowed in a fragment: it is")
      string(APPEND ERR " read by the .config loader,\n    which silently")
      string(APPEND ERR " ignores it. Fragments are flat -- list several")
      string(APPEND ERR " fragments instead.\n")
    endif()

    # A defconfig is parsed with file(STRINGS), which keeps ASCII only and
    # shreds anything else into pieces -- including empty ones, which then blow
    # up nuttx_export_kconfig() on an unquoted argument, a long way from the
    # actual cause. None of the in-tree defconfigs contain non-ASCII, so this is
    # the existing convention; say so here rather than let it surface as "string
    # sub-command REGEX ... needs at least 5 arguments".
    if(ERR STREQUAL "")
      string(REGEX MATCH "[^\t\r\n -~]" HIT "${CONTENT}")
      if(NOT HIT STREQUAL "")
        set(ERR "  ${path}\n")
        string(APPEND ERR "    a fragment has to be plain ASCII, including its")
        string(APPEND ERR " comments: defconfigs\n    are parsed with")
        string(APPEND ERR " file(STRINGS), which keeps ASCII only.\n")
      endif()
    endif()
  endif()

  set(${outerr}
      "${ERR}"
      PARENT_SCOPE)
endfunction()

# nuttx_kconfig_fragments_resolve(<out-paths-var> <out-err-var> TOKENS <tokens>
# DIR <dir>)
#
# Turn the requested tokens into ordered absolute paths.
#
# a token containing '/'  ->  used as an absolute path anything else ->
# <dir>/<token>.config, and nowhere else
#
# Errors are returned rather than raised, so that the caller decides how to
# report them and so that the function can be unit tested.

function(nuttx_kconfig_fragments_resolve outpaths outerr)
  cmake_parse_arguments(ARG "" "DIR" "TOKENS" ${ARGN})

  set(PATHS)
  set(ERR "")

  foreach(TOKEN ${ARG_TOKENS})
    if(TOKEN STREQUAL "")
      continue()
    endif()

    set(HIT "")

    if(TOKEN MATCHES "/")
      # 'frag' already made the path absolute; a relative one could only be
      # resolved against the CMake working directory, which is not where the
      # caller stood, so say so instead of guessing.
      if(NOT IS_ABSOLUTE "${TOKEN}")
        string(APPEND ERR "  fragment path is not absolute: ${TOKEN}\n")
        continue()
      endif()
      if(NOT EXISTS "${TOKEN}" OR IS_DIRECTORY "${TOKEN}")
        string(APPEND ERR "  no such fragment file: ${TOKEN}\n")
        continue()
      endif()
      set(HIT "${TOKEN}")
    else()
      set(NAME "${TOKEN}")
      if(NOT NAME MATCHES "\\.config$")
        set(NAME "${NAME}.config")
      endif()
      if(EXISTS "${ARG_DIR}/${NAME}" AND NOT IS_DIRECTORY "${ARG_DIR}/${NAME}")
        set(HIT "${ARG_DIR}/${NAME}")
      else()
        nuttx_kconfig_fragments_available(AVAILABLE DIR "${ARG_DIR}")
        string(APPEND ERR "  no fragment '${NAME}' next to the board")
        string(APPEND ERR " defconfig:\n    ${ARG_DIR}\n")
        if(AVAILABLE STREQUAL "")
          string(APPEND ERR "  that directory holds no fragment at all.\n")
        else()
          set(NAMES "")
          foreach(CAND ${AVAILABLE})
            string(APPEND NAMES " ${CAND}")
          endforeach()
          string(APPEND ERR "  it holds:${NAMES}\n")
        endif()
        string(APPEND ERR "  Give an absolute path to use a fragment kept")
        string(APPEND ERR " elsewhere.\n")
        continue()
      endif()
    endif()

    nuttx_kconfig_fragments_validate("${HIT}" VALIDATE_ERR)
    if(NOT VALIDATE_ERR STREQUAL "")
      string(APPEND ERR "${VALIDATE_ERR}")
      continue()
    endif()

    if("${HIT}" IN_LIST PATHS)
      message(WARNING "Kconfig fragment listed more than once: ${HIT}")
    endif()
    list(APPEND PATHS "${HIT}")
  endforeach()

  set(${outpaths}
      "${PATHS}"
      PARENT_SCOPE)
  set(${outerr}
      "${ERR}"
      PARENT_SCOPE)
endfunction()

# nuttx_kconfig_fragments_signature(<out-var> PATHS <ordered paths>)
#
# Short digest of the ordered fragment list *and* of every fragment's content.
# Carried in the assembled defconfig's file name, which is what makes
# CMakeLists.txt re-expand .config when a fragment changes: the existing gate
# there already compares NUTTX_DEFCONFIG against the cached
# NUTTX_DEFCONFIG_SAVED.
#
# An empty list yields a well defined value, and reordering the same fragments
# yields a different one, because the order decides which assignment wins.

function(nuttx_kconfig_fragments_signature outvar)
  cmake_parse_arguments(ARG "" "" "PATHS" ${ARGN})

  # Newline separated to keep the material free of CMake list separators
  set(MATERIAL "")
  foreach(FRAGMENT ${ARG_PATHS})
    set(HASH "missing")
    if(EXISTS "${FRAGMENT}" AND NOT IS_DIRECTORY "${FRAGMENT}")
      file(SHA256 "${FRAGMENT}" HASH)
    endif()
    string(APPEND MATERIAL "${FRAGMENT}\n${HASH}\n")
  endforeach()

  string(SHA256 DIGEST "${MATERIAL}")
  string(SUBSTRING "${DIGEST}" 0 8 SHORT)

  set(${outvar}
      "${SHORT}"
      PARENT_SCOPE)
endfunction()

# nuttx_kconfig_fragments_assemble(<out-var> BASE <defconfig> PATHS <ordered>
# SIGNATURE <digest> OUTPUT_DIR <dir>)
#
# Write <dir>/.defconfig.assembled.<digest>: a copy of BASE with every fragment
# appended in order. Returns that path.
#
# A separate file rather than an append to .defconfig.processed, so that
# .defconfig.processed keeps meaning exactly what it means today (the pure
# #include expansion of the board defconfig) and the config_tree.json vs
# config_tree_dirty.json decision in nuttx_process_config.cmake stays valid.
#
# Each fragment is preceded by a marker comment. It guarantees a newline between
# files (a hand written fragment may lack a trailing one), gives kconfiglib's
# line numbered warnings something to point at, and keeps the origin of every
# assignment visible in ${CMAKE_BINARY_DIR}/defconfig.

function(nuttx_kconfig_fragments_assemble outvar)
  cmake_parse_arguments(ARG "" "BASE;SIGNATURE;OUTPUT_DIR" "PATHS" ${ARGN})

  set(OUTPUT "${ARG_OUTPUT_DIR}/.defconfig.assembled.${ARG_SIGNATURE}")

  # Keep one assembled defconfig per build directory
  file(GLOB STALE "${ARG_OUTPUT_DIR}/.defconfig.assembled.*")
  foreach(ENTRY ${STALE})
    if(NOT ENTRY STREQUAL OUTPUT)
      file(REMOVE "${ENTRY}")
    endif()
  endforeach()

  file(READ "${ARG_BASE}" CONTENT)
  file(WRITE "${OUTPUT}" "${CONTENT}")

  foreach(FRAGMENT ${ARG_PATHS})
    file(READ "${FRAGMENT}" CONTENT)
    file(APPEND "${OUTPUT}" "\n# --- Kconfig fragment: ${FRAGMENT}\n")
    file(APPEND "${OUTPUT}" "${CONTENT}")
  endforeach()

  set(${outvar}
      "${OUTPUT}"
      PARENT_SCOPE)
endfunction()

# nuttx_kconfig_fragments_verify(<config-file> PATHS <ordered> [STRICT <bool>])
#
# Report every value a fragment asked for that is not the value in
# <config-file>. STRICT defaults to OFF, i.e. a mismatch warns; ON makes it fail
# the configure.
#
# Only the keys the fragments themselves assign are looked at. That is what
# keeps a legitimate choice switch from being reported: the base defconfig's
# now-deselected member is not a fragment key, so it never enters the
# comparison.
#
# ~~~
#   requested value == value in <config-file>              -> ok
#   requested n or "", and the key is absent altogether    -> ok
#                     (the symbol is invisible, which is the same as default)
#   anything else                                          -> did not take effect
# ~~~

function(nuttx_kconfig_fragments_verify configfile)
  cmake_parse_arguments(ARG "" "STRICT" "PATHS" ${ARGN})

  if("${ARG_STRICT}" STREQUAL "")
    set(ARG_STRICT OFF)
  endif()

  if(NOT EXISTS "${configfile}")
    message(FATAL_ERROR "nuttx_kconfig_fragments_verify: no such configuration "
                        "file: ${configfile}")
  endif()

  file(READ "${configfile}" DOTCONFIG)
  # Bracket the content so that the first and the last line can be matched with
  # the same "\n<line>\n" test as the others
  set(DOTCONFIG "\n${DOTCONFIG}\n")

  set(REPORT "")

  foreach(FRAGMENT ${ARG_PATHS})
    file(READ "${FRAGMENT}" REST)
    set(LINENO 0)
    set(SCANNING TRUE)

    # Hand rolled line scan: see the implementation note in the file header for
    # why file(STRINGS)/list() must not be used on configuration content
    while(SCANNING)
      math(EXPR LINENO "${LINENO} + 1")

      string(FIND "${REST}" "\n" NEWLINE)
      if(NEWLINE EQUAL -1)
        set(LINE "${REST}")
        set(REST "")
        set(SCANNING FALSE)
      else()
        string(SUBSTRING "${REST}" 0 ${NEWLINE} LINE)
        math(EXPR AFTER "${NEWLINE} + 1")
        string(SUBSTRING "${REST}" ${AFTER} -1 REST)
      endif()

      string(REGEX REPLACE "[ \t\r]+$" "" LINE "${LINE}")

      set(KEY "")
      set(WANT "")
      string(REGEX MATCH "^# (CONFIG_[A-Za-z0-9_]+) is not set$" MATCHED
                   "${LINE}")
      if(NOT MATCHED STREQUAL "")
        set(KEY "${CMAKE_MATCH_1}")
        set(WANT "n")
      else()
        string(REGEX MATCH "^(CONFIG_[A-Za-z0-9_]+)=(.*)$" MATCHED "${LINE}")
        if(NOT MATCHED STREQUAL "")
          set(KEY "${CMAKE_MATCH_1}")
          set(WANT "${CMAKE_MATCH_2}")
        endif()
      endif()

      if(KEY STREQUAL "")
        continue()
      endif()

      # Compare against the spelling the configuration actually uses, not
      # against the fragment's own line: a bool set to n may be written either
      # 'CONFIG_X=n' or '# CONFIG_X is not set' in a fragment, while .config
      # always writes the latter. Both are accepted by the Kconfig loader, and
      # both are in use in the in-tree defconfigs.
      if(WANT STREQUAL "n")
        string(FIND "${DOTCONFIG}" "\n# ${KEY} is not set\n" EFFECTIVE)
      else()
        string(FIND "${DOTCONFIG}" "\n${KEY}=${WANT}\n" EFFECTIVE)
      endif()
      if(NOT EFFECTIVE EQUAL -1)
        continue()
      endif()

      # Requesting n or the empty string is still honoured when the symbol is
      # invisible, in which case it is absent from the configuration altogether
      string(REGEX MATCH "\n(# )?${KEY}[ =][^\n]*" PRESENT "${DOTCONFIG}")
      if(PRESENT STREQUAL "" AND (WANT STREQUAL "n" OR WANT STREQUAL "\"\""))
        continue()
      endif()

      get_filename_component(SHORTNAME "${FRAGMENT}" NAME)
      if(PRESENT STREQUAL "")
        set(WHY "${KEY} is not in the configuration at all")
      else()
        # Show what the configuration really says: for a choice member that is
        # far more telling than "a different value"
        string(REGEX REPLACE "^\n" "" ACTUAL "${PRESENT}")
        set(WHY "the configuration says: ${ACTUAL}")
      endif()
      # One string(APPEND) per line and no list involved, so that a ';' inside a
      # reported value survives into the message
      string(APPEND REPORT "  ${SHORTNAME}:${LINENO}\n")
      string(APPEND REPORT "      requested: ${LINE}\n")
      string(APPEND REPORT "      but ${WHY}\n")
    endwhile()
  endforeach()

  if(REPORT STREQUAL "")
    return()
  endif()

  set(TEXT "Kconfig fragment values did not take effect:\n")
  string(APPEND TEXT "${REPORT}")
  string(APPEND TEXT "Reasons a value gets dropped:\n")
  string(APPEND TEXT "  - the symbol is a choice member and the fragment tried")
  string(APPEND TEXT " to turn it off.\n    A choice member cannot be turned")
  string(APPEND TEXT " off, only exchanged: neither\n    CONFIG_X=n nor")
  string(APPEND TEXT " '# CONFIG_X is not set' has any effect on one. Assign\n")
  string(APPEND TEXT "    the sibling you do want instead.\n")
  string(APPEND TEXT "  - its dependencies are unmet, so the symbol is not")
  string(APPEND TEXT " visible at all.\n")
  string(APPEND TEXT "  - another symbol 'select's it, which outranks a user")
  string(APPEND TEXT " value of n.\n")
  string(APPEND TEXT "  tcc -n CONFIG_X                 to see why\n")

  if(ARG_STRICT)
    string(APPEND TEXT "  -DKCONFIG_FRAGMENTS_STRICT=OFF  to downgrade this")
    string(APPEND TEXT " to a warning")
    message(FATAL_ERROR "${TEXT}")
  else()
    string(APPEND TEXT "  -DKCONFIG_FRAGMENTS_STRICT=ON   to make this an")
    string(APPEND TEXT " error instead")
    message(WARNING "${TEXT}")
  endif()
endfunction()
