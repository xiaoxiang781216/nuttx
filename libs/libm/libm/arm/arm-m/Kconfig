#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_ARMV7M || ARCH_ARMV8M

config ARM_M_LIBM
	bool "Architecture specific FPU optimizations"
	default n
	select LIBM_ARCH_FABSF
	select LIBM_ARCH_SQRTF
	select LIBM_ARCH_CEILF if ARCH_ARMV8M
	select LIBM_ARCH_FLOORF if ARCH_ARMV8M
	select LIBM_ARCH_NEARBYINTF if ARCH_ARMV8M
	select LIBM_ARCH_RINTF if ARCH_ARMV8M
	select LIBM_ARCH_ROUNDF if ARCH_ARMV8M
	select LIBM_ARCH_TRUNCF if ARCH_ARMV8M
	select LIBM_ARCH_CEIL if ARCH_ARMV8M && ARCH_DPFPU
	select LIBM_ARCH_FLOOR if ARCH_ARMV8M && ARCH_DPFPU
	select LIBM_ARCH_NEARBYINT if ARCH_ARMV8M && ARCH_DPFPU
	select LIBM_ARCH_RINT if ARCH_ARMV8M && ARCH_DPFPU
	select LIBM_ARCH_ROUND if ARCH_ARMV8M && ARCH_DPFPU
	select LIBM_ARCH_TRUNC if ARCH_ARMV8M && ARCH_DPFPU
	depends on ARCH_FPU
	depends on LIBM
	---help---
		Enable ARM-M specific floating point optimizations.

# Backward compatibility: old ARMv7-M config name

config ARMV7M_LIBM
	bool "Architecture specific FPU optimizations (deprecated, use ARM_M_LIBM)"
	default n
	depends on ARCH_FPU && LIBM && ARCH_ARMV7M
	select ARM_M_LIBM

# Backward compatibility: old ARMv8-M config name

config ARMV8M_LIBM
	bool "Architecture specific optimizations (deprecated, use ARM_M_LIBM)"
	default n
	depends on ARCH_FPU && LIBM && ARCH_ARMV8M
	select ARM_M_LIBM

endif
