#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config ARM_TARGET2_PREL
	bool "R_ARM_TARGET2 is PC relative"
	default CXX_EXCEPTION
	depends on LIBC_ARCH_ELF
	---help---
		Perform a PC relative relocation for relocation type R_ARM_TARGET2

if ARCH_ARM_M

config ARM_M_STRING_FUNCTION
	bool "Enable optimized ARM-M specific string functions"
	default n
	depends on ARCH_TOOLCHAIN_GNU
	select ARM_M_MEMCHR
	select ARM_M_MEMCPY
	select ARM_M_MEMSET
	select ARM_M_MEMMOVE
	select ARM_M_STRCMP
	select ARM_M_STRCPY
	select ARM_M_STRLEN

config ARM_M_MEMCHR
	bool "Enable optimized memchr() for ARM-M"
	default n
	select LIBC_ARCH_MEMCHR
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM-M specific memchr() library function

config ARM_M_MEMCPY
	bool "Enable optimized memcpy() for ARM-M"
	default n
	select LIBC_ARCH_MEMCPY
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM-M specific memcpy() library function

config ARM_M_MEMSET
	bool "Enable optimized memset() for ARM-M"
	default n
	select LIBC_ARCH_MEMSET
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM-M specific memset() library function

config ARM_M_MEMMOVE
	bool "Enable optimized memmove() for ARM-M"
	default n
	select LIBC_ARCH_MEMMOVE
