#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_ARM_A_R

config ARM_A_R_STRING_FUNCTION
	bool "Enable optimized ARM A/R specific string function"
	default n
	depends on ARCH_TOOLCHAIN_GNU
	select ARM_A_R_MEMCHR
	select ARM_A_R_MEMCPY
	select ARM_A_R_MEMMOVE
	select ARM_A_R_MEMSET
	select ARM_A_R_STRCMP
	select ARM_A_R_STRLEN

config ARM_A_R_MEMCHR
	bool "Enable optimized memchr() for ARM A/R"
	default n
	select LIBC_ARCH_MEMCHR
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific memchr() library function

config ARM_A_R_MEMCPY
	bool "Enable optimized memcpy() for ARM A/R"
	default n
	select LIBC_ARCH_MEMCPY
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific memcpy() library function

config ARM_A_R_MEMMOVE
	bool "Enable optimized memmove() for ARM A/R"
	default n
	select LIBC_ARCH_MEMMOVE
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific memmove() library function

config ARM_A_R_MEMSET
	bool "Enable optimized memset() for ARM A/R"
	default n
	select LIBC_ARCH_MEMSET
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific memset() library function

config ARM_A_R_STRCMP
	bool "Enable optimized strcmp() for ARM A/R"
	default n
	select LIBC_ARCH_STRCMP
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific strcmp() library function

config ARM_A_R_STRLEN
	bool "Enable optimized strlen() for ARM A/R"
	default n
	select LIBC_ARCH_STRLEN
	depends on ARCH_TOOLCHAIN_GNU
	---help---
		Enable optimized ARM A/R specific strlen() library function

endif
