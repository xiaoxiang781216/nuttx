#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config FS_FUSE
	bool "FUSE (Filesystem in Userspace) core"
	default n
	depends on !DISABLE_MOUNTPOINT
	---help---
		Enable the transport-independent FUSE client core.  The core
		implements the NuttX mountpt_operations on top of the standard
		FUSE wire protocol and dispatches requests through a pluggable
		transport (see FS_FUSE_DEV and FS_VIRTIOFS).  The core alone has
		no transport; enable at least one transport to mount a FUSE
		filesystem.

config FS_VIRTIOFS
	bool "virtio-fs guest transport"
	default n
	depends on FS_FUSE
	select DRIVERS_VIRTIO
	---help---
		Register the virtio-fs guest transport.  Mount a host directory
		shared through a virtio-fs device with the "tag=<name>" mount
		option; the FUSE protocol is carried over the request virtqueue
		to the host server (for example QEMU virtiofsd or the vhost-fs
		host service).
