#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig FS_FATFS
	bool "FATFS File System"
	default n
	depends on !DISABLE_MOUNTPOINT
	---help---
		Build the FATFS file system. http://elm-chan.org/fsw/ff/00index_e.html

config FS_FATFS_SECTOR_RATIO
	int "The ratio between fatfs filesystem sector and block device sector"
	depends on FS_FATFS
	default 1

config FS_FATFS_ERROR_LOG
	bool "FATFS file system output detail error log"
	depends on DEBUG_FS_ERROR
	---help---
		Enable FATFS file system detail error log.

config FS_FATFS_DEBUG
	bool "FATFS file system read/write double check"
	depends on DEBUG_FS_ERROR
	---help---
		Enable FATFS file system read/write double check.

config FS_FATFS_MAX_OPEN_FILES
	int "The maximum number of open files in fatfs filesystem"
	depends on FS_FATFS
	default 256

config FS_FATFS_RPATH
	int "FATFS relative path support level"
	depends on FS_FATFS
	default 2
	range 0 2
	---help---
		Configure relative path support in FatFs (FF_FS_RPATH):
		  0: Disable relative path. Path names starting from the root
		     directory only. Path segments "." and ".." are rejected
		     with FR_INVALID_NAME.
		  1: Enable relative path. f_chdir() and f_chdrive() available.
		  2: f_getcwd() available in addition to level 1.

		Level >= 1 is required to open files through path names that
		contain "." or ".." segments (e.g. "../data/file").
