#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config DRIVERS_VHOST
	bool
	select OPENAMP
	select SCHED_WORKQUEUE
	default n

config DRIVERS_VHOST_BLK
	bool "Virtual Host Blk Device Support"
	default n
	select DRIVERS_VHOST

if DRIVERS_VHOST_BLK

config DRIVERS_VHOST_BLK_PRIORITY
	int "vhost blk thread priority"
	default 224

config DRIVERS_VHOST_BLK_STACKSIZE
	int "vhost blk stack size"
	default 4096

endif # DRIVERS_VHOST_BLK

config DRIVERS_VHOST_CAN
	bool "Virtual Host CAN Device Support"
	depends on NET_CAN
	default n
	select DRIVERS_VHOST
	select NET_CAN_HAVE_CANFD
	---help---
		Enable the vhost CAN backend.  It bridges a VirtIO CAN device
		(device ID 36) to a local SocketCAN interface, forwarding frames
		between the guest tx/rx/control virtqueues and the local bus.

config DRIVERS_VHOST_NET
	bool "Virtual Host Net Device Support"
	depends on NETDEVICES
	default n
	select ARCH_HAVE_NETDEV_STATISTICS
	select NETDEV_LATEINIT
	select DRIVERS_VHOST

config DRIVERS_VHOST_I2C
	bool "Virtual Host I2C Device Support"
	default n
	select I2C
	select DRIVERS_VHOST
	---help---
		Enable the vhost (device-side) I2C backend.  When an rptun resource
		table exposes a VirtIO I2C adapter device (device ID 34) in the
		device role, this driver serves the request virtqueue, decodes each
		request with the OASIS VirtIO I2C wire format, and forwards it to a
		local I2C lower-half registered with vhost_i2c_register().  This lets
		one NuttX instance export an I2C bus to a remote VirtIO I2C frontend,
		the native-VirtIO counterpart of the RPMSG I2C server.

config DRIVERS_VHOST_SPI
	bool "Virtual Host SPI Device Support"
	depends on SPI && SPI_EXCHANGE
	default n
	select DRIVERS_VHOST
	---help---
		Enable the vhost (device-side) SPI backend.  When an rptun resource
		table exposes a VirtIO SPI device (device ID 45) in the device role,
		this driver serves the request virtqueue, decodes each transfer with
		the Linux-compatible VirtIO SPI wire format, and drives a local SPI
		lower-half registered with vhost_spi_register().

config DRIVERS_VHOST_PING
	bool "Virtual Host Ping Device Support"
	default n
	select DRIVERS_VHOST
	---help---
		Enable the vhost (device-side) ping backend.  When an rptun resource
		table exposes a VirtIO ping device (vendor-local device ID 63) in the
		device role, this driver serves the request virtqueue by echoing each
		request's sequence number back through the writable segment of the
		same descriptor chain, optionally verifying the payload.  It is the
		peer of DRIVERS_VIRTIO_PING and is diagnostic-only.

config DRIVERS_VHOST_RNG
	bool "Virtual Host Rng Device Support"
	default n
	select DRIVERS_VHOST

config DRIVERS_VHOST_RPMSG
	bool "Virtual Host Rpmsg Device Support"
	default n
	select RPMSG_VIRTIO
	select DRIVERS_VHOST

config DRIVERS_VHOST_SERIAL
	bool "Virtual Host Serial Device Support"
	default n

if DRIVERS_VHOST_SERIAL

config DRIVERS_VHOST_SERIAL_PRIORITY
	int "vhost serial thread priority"
	default 224

config DRIVERS_VHOST_SERIAL_STACKSIZE
	int "vhost serial stack size"
	default DEFAULT_TASK_STACKSIZE

endif

config DRIVERS_VHOST_RPMB
	bool "Virtual Host Rpmb Device Support"
	default n
	select DRIVERS_VHOST

if DRIVERS_VHOST_RPMB

config DRIVERS_VHOST_RPMB_PRIORITY
	int "vhost rpmb thread priority"
	default 224

config DRIVERS_VHOST_RPMB_STACKSIZE
	int "vhost rpmb stack size"
	default DEFAULT_TASK_STACKSIZE

endif
