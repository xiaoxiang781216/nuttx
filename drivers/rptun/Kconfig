#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

menuconfig RPTUN
	bool "Remote Proc Tunnel Driver Support"
	default n
	select RPMSG_VIRTIO
	---help---
		RPTUN driver is used for multi-cores' communication.

if RPTUN

choice RPTUN_AUTO_RESET
	prompt "rptun auto reset peer"
	default RPTUN_AUTO_RESET_IN_REBOOT_NOTIFIER if BMP
	default RPTUN_AUTO_RESET_IN_PANIC_NOTIFIER if !BMP

config RPTUN_AUTO_RESET_DISABLE
	bool "rptun auto reset feature disabled"

config RPTUN_AUTO_RESET_IN_PANIC_NOTIFIER
	bool "rptun panic other core in panic notifier"
	---help---
		Panic peer in the panic notifier and Reboot/Poweroff peer in
		the reboot notifier. This mode is used for the case that the
		main core do the coredump after panic all the peer cores.

config RPTUN_AUTO_RESET_IN_REBOOT_NOTIFIER
	bool "rptun panic other core in reboot notifier"
	---help---
		Panic/Reboot/Poweroff peer all in the reboot notifier.
		This mode is used for the case that all the core do its
		coredump by itself.

endchoice # RPTUN_AUTO_RESET

config RPTUN_REMOTE_PANIC_SILENT
	bool "Silence syslog on remote-triggered panic"
	default n
	---help---
		When a remote core triggers a panic on this core, silence
		all syslog output by setting logmask to LOG_NONE. The log
		mask is restored at PANIC_KERNEL_FINAL before coredump and
		RAMLOG dump, so only the originating core's crash log is
		printed during the panic sequence.

config RPTUN_BMP
	bool "rptun bmp support"
	default n
	---help---
		This is a rptun driver for communications in bmp
		environments. With this driver, Each ends communicate with each
		other by using the native rpmsg
		or various Rpmsg services have been implemented in NuttX.

config RPTUN_IVSHMEM
	bool "rptun ivshmem support"
	default n
	depends on PCI_IVSHMEM
	---help---
		This is rptun driver based on pci ivshmem.

if RPTUN_IVSHMEM

config RPTUN_IVSHMEM_NAME
	string "rptun ivshmem name"
	---help---
		Using this config to custom the rptun ivshmem cpuname and role,
		using ";" to split the names.
		For example, if RPTUN_IVSHMEM_CPUNAME = "0:cpu1:m;1:cpu2:s" and pass
		two ivshmem devices to the qemu, we will get two rptun ivshmem
		drivers with ivshmem device match id: [0, 1],
		remote cpu names: ["cpu1", "cpu2"] and roles: ["master", "slave"']

config RPTUN_IVSHMEM_BUFFSIZE
	int "rptun ivshmem rpmsg buffer size"
	default 2048
	---help---
		The rpmsg buffer size in resource table, the RX and TX buffer size
		are same for now.

config RPTUN_IVSHMEM_BUFFNUM
	int "rptun ivshmem rpmsg buffer number"
	default 8
	---help---
		The rpmsg buffer number in resource table, the RX and TX buffer number
		are same for now.

config RPTUN_IVSHMEM_RPMB_PATH
	string "rptun ivshmem backend eMMC RPMB device path"
	depends on DRIVERS_VHOST_RPMB
	default "/dev/mmcsd0rpmb"
	---help---
		Path of the backend eMMC RPMB partition opened by the vhost-rpmb
		driver on the device side. It is published into the RPMB vdev
		config space (struct vhost_rpmb_config_s) of the ivshmem resource
		table so the vhost-rpmb probe can open the real RPMB block device.

endif

config RPTUN_START_SYNC
	bool "rptun start devices synchronously"
	default n
	---help---
		By default rptun spawns a short lived "rptun" kernel thread on every
		start to bring the remote proc up and to wait for the peer to publish
		VIRTIO_CONFIG_STATUS_DRIVER_OK.  Each start/stop cycle therefore
		allocates and releases a TCB and a stack, and the stop path has to
		SIGKILL the thread out of its peer wait.

		Enable this option to run the whole sequence inline in the caller's
		context instead.  No thread is created and a start/stop cycle performs
		no dynamic allocation at all.

		Be aware of the trade-off: the caller blocks until the peer is ready.
		With RPTUN_IS_AUTOSTART this stalls board bring-up, and when entered
		through RPTUNIOC_START (rptun_boot()) the global rptun lock is held for
		the whole wait, which blocks rptun_reset()/rptun_poweroff() on every
		rptun instance, including from the panic notifier.

		Only select this when the peer is known to be up before this side
		starts, or when stalling the caller is acceptable.

config RPTUN_PRIORITY
	int "rptun thread priority"
	default 224

config RPTUN_STACKSIZE
	int "rptun stack size"
	default 4096

config RPTUN_STATUS_TIMEOUT_MS
	int "rptun status timeout ms"
	default 5000

config RPTUN_LOADER
	bool "rptun loader support"
	default n

config RPTUN_TRACE_DUMP
	bool "rptun dump remote core's syslog"
	default n

endif # RPTUN
