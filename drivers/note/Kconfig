config DRIVERS_NOTENET
	bool "Note to netdev"
	select DRIVERS_NOTE
	depends on NETDEVICES && NET_NETPOLL
	default n
	---help---
		Use the netdev as a Note output device

if DRIVERS_NOTENET

config DRIVERS_NOTENET_INTF
	string "Note netdev interface"
	default "eth0"
	---help---
		Network interface used for netdev Note.

config DRIVERS_NOTENET_IPADDR
	hex "Note netdev destination IP addres"
	default 0xffffffff
	---help---
