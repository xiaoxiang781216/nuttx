config DRIVERS_NOTENET_CPUSET
	hex "Note netdev lower output CPU set"
	depends on !UP && SCHED_INSTRUMENTATION_FILTER
	default SCHED_INSTRUMENTATION_CPUSET
	---help---
		CPU set for note netdev

config DRIVERS_NOTENET_WORK_DELAY
	int "NOTE netdev work delay (ms)"
	default 100

