		Default: broadcast IP address.

config DRIVERS_NOTENET_MAC
	string "Note netdev destination MAC addres"
	default "ff:ff:ff:ff:ff:ff"
	---help---
		MAC address where where netdev sends Note output.
		Default: broadcast MAC address.

config DRIVERS_NOTENET_PORT
	int "Note netdev port"
	default 50000
	---help---
		UDP port for Note output.

config DRIVERS_NOTENET_FILTER_DEFAULT_MODE
	hex "Note netdev lower output filter mode"
	depends on SCHED_INSTRUMENTATION_FILTER
	default SCHED_INSTRUMENTATION_FILTER_DEFAULT_MODE
	---help---
