include nanoplus/Make.defs

CHIP_CSRCS = zsp_sim_hostfs.c zsp_sim_timer.c

# Disable zopt for zsp_sim_hostfs.c: the zopt assembler optimizer renames
# hardcoded registers inside inline asm, breaking semihosting which
# requires specific register assignments (r7=opcode, a6=magic, etc).

chip/zsp_sim_hostfs.c_CFLAGS += -mno_zopt
