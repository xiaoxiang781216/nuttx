#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_ZSP
comment "ZSP Options"

config ARCH_CHIP_ZSP_NANOPLUS
	bool
	default n
	select ARCH_HAVE_INTERRUPTSTACK
	select LIBC_ATOMIC_IRQ

config ARCH_FAMILY
	string
	default "nanoplus" if ARCH_CHIP_ZSP_NANOPLUS

choice
	prompt "ZSP Chip Selection"
	default ARCH_CHIP_ZSP_SIM

config ARCH_CHIP_ZSP_SIM
	bool "ZSP NanoPlus Simulator"
	select ARCH_CHIP_ZSP_NANOPLUS
	select ONESHOT
	select ONESHOT_COUNT
	select ALARM_ARCH
	---help---
		ZSP NanoPlus running on zsimg5 instruction-accurate simulator.

endchoice

config ARCH_CHIP
	string
	default "zsp_sim" if ARCH_CHIP_ZSP_SIM

endif # ARCH_ZSP
