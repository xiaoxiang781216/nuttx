# The vector table is the "head" object, i.e., the one that must forced into
# the link in order to draw in all of the other components

HEAD_ASRC += arm_vectortab.S

# Common ARM_A_R files

CMN_ASRCS += arm_vectors.S arm_saveusercontext.S arm_head.S

CMN_CSRCS += arm_tcbinfo.c arm_doirq.c arm_dataabort.c arm_syscall.c
CMN_CSRCS += arm_prefetchabort.c arm_cpuidlestack.c arm_initialstate.c
CMN_CSRCS += arm_undefinedinsn.c arm_allocpage.c arm_perf.c
CMN_CSRCS += arm_gicv2_dump.c arm_cache.c arm_cpuinfo.c cp15_cacheops.c

ifeq ($(CONFIG_ARM_GIC_VERSION),2)
  CMN_CSRCS += arm_gicv2.c
  ifeq ($(CONFIG_ARM_GICv2M),y)
    CMN_CSRCS += arm_gicv2m.c
  endif
endif

ifeq ($(CONFIG_ARM_HAVE_PTM),y)
  CMN_CSRCS += arm_timer.c
endif

ifneq ($(CONFIG_DISABLE_SIGNALS),y)
  CMN_CSRCS += arm_schedulesigaction.c arm_sigdeliver.c
endif

ifeq ($(CONFIG_LIB_SYSCALL),y)
  CMN_ASRCS += arm_dispatch_syscall.S
endif

ifeq ($(CONFIG_ARCH_HAVE_DEBUG),y)
  CMN_CSRCS += arm_hwdebug.c
endif

ifeq ($(CONFIG_LEGACY_PAGING),y)
  CMN_CSRCS += arm_checkmapping.c
endif

ifeq ($(CONFIG_ARCH_HIPRI_INTERRUPT),y)
  CMN_CSRCS += arm_dofiq.c
endif

ifeq ($(CONFIG_ARCH_FPU),y)
  CMN_CSRCS += arm_fpucmp.c
  CMN_ASRCS += arm_fpuconfig.S
endif

ifeq ($(CONFIG_ARM_L2CC_PL310),y)
  CMN_CSRCS += arm_l2cc_pl310.c
endif

ifneq ($(CONFIG_UP),y)
  CMN_CSRCS += arm_scu.c arm_cpucall.c arm_cpustart.c
  CMN_ASRCS += arm_cpuhead.S
endif

ifeq ($(CONFIG_ARM_MPU),y)
  CMN_CSRCS += arm_mpu.c
endif

ifeq ($(CONFIG_ARCH_ADDRENV)$(CONFIG_ARM_MPU),yy)
  CMN_CSRCS += arm_addrenv_mpu.c
endif

ifeq ($(CONFIG_ARCH_ADDRENV)$(CONFIG_ARCH_USE_MMU),yy)
  CMN_CSRCS += arm_addrenv_mmu.c
endif

ifeq ($(CONFIG_ARCH_TRUSTZONE_SECURE),y)
  CMN_CSRCS += arm_sm_runtime.c
  CMN_ASRCS += arm_sm_vector.S
endif

ifeq ($(CONFIG_ARM_PSCI),y)
  CMN_ASRCS += arm_smccc.S
  CMN_CSRCS += arm_cpu_psci.c
endif

ifeq ($(CONFIG_ARCH_USE_MMU),y)
  CMN_CSRCS += arm_mmu.c
endif

ifeq ($(CONFIG_LEGACY_PAGING),y)
  CMN_ASRCS += arm_pghead.S
  CMN_CSRCS += arm_pginitialize.c
  CMN_CSRCS += arm_va2pte.c
endif

ifeq ($(CONFIG_ARCH_ADDRENV)$(CONFIG_ARCH_USE_MMU),yy)
  CMN_CSRCS += arm_addrenv_utils.c arm_addrenv_perms.c arm_pgalloc.c
  CMN_CSRCS += arm_addrenv_pgmap.c
  ifeq ($(CONFIG_ARCH_STACK_DYNAMIC),y)
    CMN_CSRCS += arm_addrenv_ustack.c
  endif
  ifeq ($(CONFIG_ARCH_KERNEL_STACK),y)
    CMN_CSRCS += arm_addrenv_kstack.c
  endif
  ifeq ($(CONFIG_ARCH_VMA_MAPPING),y)
    CMN_CSRCS += arm_addrenv_shm.c
  endif
endif

ifeq ($(CONFIG_MM_PGALLOC),y)
  CMN_CSRCS += arm_physpgaddr.c
  ifeq ($(CONFIG_ARCH_PGPOOL_MAPPING),y)
    CMN_CSRCS += arm_virtpgaddr.c
  endif
endif

ifeq ($(CONFIG_ARCH_PERF_EVENTS_USER_ACCESS),y)
  CMN_UCSRCS += arm_perf.c
endif
